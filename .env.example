# =============================================================================
# Kissan AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own values:
#
#   cp .env.example .env
#
# NEVER commit your .env file. It is ignored by git automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SIDE VARIABLES (prefixed with VITE_ — bundled into the browser app)
# -----------------------------------------------------------------------------

# Supabase project URL (public, not a secret)
# Get from: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose — protected by Row Level Security)
# Get from: Supabase Dashboard → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# SERVER-SIDE VARIABLES (used by Supabase Edge Functions only — NOT in browser)
# These must be added as Supabase Edge Function secrets:
#   Supabase Dashboard → Edge Functions → Secrets
# -----------------------------------------------------------------------------

# Google Gemini API key (required for: Crop Doctor, AI Chat, Risk Assessment,
# Crop Recommendations, Irrigation Advisor, Today's Actions)
# Get from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key

# OpenWeatherMap API key (NO LONGER NEEDED — weather now uses Open-Meteo, free API)
# Kept for reference only. Can be safely removed from Edge Function secrets.
# OPENWEATHER_API_KEY=your_openweather_api_key

# Speechmatics API key (optional — legacy voice STT provider, kept for fallback)
# Get from: https://www.speechmatics.com
# SPEECHMATICS_API_KEY=your_speechmatics_api_key

# Sarvam AI API key (required for: Voice Assistant speech-to-text)
# Get from: https://www.sarvam.ai
# Add to Supabase Dashboard → Edge Functions → Secrets
# SARVAM_API_KEY=your_sarvam_api_key

# Supabase service role key (auto-provided by Supabase — used for
# server-side writes. NEVER expose this to the browser.)
# SUPABASE_SERVICE_ROLE_KEY is set automatically by Supabase Edge Functions.
